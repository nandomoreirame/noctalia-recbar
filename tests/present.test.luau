local assert = require("./support/assert")
local runner = require("./support/runner")
local modules = require("./support/modules")

local describe, it = runner.describe, runner.it
local present = modules.load("lib/present.luau")

describe("present.parse", function()
	it("reads mode and start epoch from the gsr-toggle state line", function()
		local rec = present.parse("gif 1700000000 /tmp/Vídeos/Recordings/gif_x.mp4\n")
		assert.equal(rec.mode, "gif")
		assert.equal(rec.since, 1700000000)
	end)

	it("accepts the video mode", function()
		assert.equal(present.parse("video 1700000000 /tmp/a.mp4").mode, "video")
	end)

	it("returns nil for a missing, empty or malformed state", function()
		assert.equal(present.parse(nil), nil)
		assert.equal(present.parse(""), nil)
		assert.equal(present.parse("garbage"), nil)
		assert.equal(present.parse("audio 1700000000 /tmp/a.mp4"), nil)
		assert.equal(present.parse("gif notanumber /tmp/a.mp4"), nil)
	end)
end)

describe("present.clock", function()
	it("formats minutes and seconds", function()
		assert.equal(present.clock(0), "00:00")
		assert.equal(present.clock(7), "00:07")
		assert.equal(present.clock(83), "01:23")
		assert.equal(present.clock(3599), "59:59")
	end)

	it("adds hours past one hour", function()
		assert.equal(present.clock(3600), "1:00:00")
		assert.equal(present.clock(3725), "1:02:05")
	end)

	it("clamps negative values (clock skew) to zero", function()
		assert.equal(present.clock(-5), "00:00")
	end)
end)

describe("present.bar", function()
	it("is hidden when nothing is recording", function()
		assert.equal(present.bar(nil, 100).visible, false)
	end)

	it("shows REC and elapsed time for a video recording", function()
		local m = present.bar({ mode = "video", since = 1000 }, 1083)
		assert.equal(m.visible, true)
		assert.equal(m.label, "REC")
		assert.equal(m.elapsed, "01:23")
		assert.equal(m.glyph, "player-record-filled")
	end)

	it("shows GIF for a gif recording", function()
		assert.equal(present.bar({ mode = "gif", since = 1000 }, 1005).label, "GIF")
	end)

	it("always emits fill and colors so the reconciler never keeps stale ones", function()
		local m = present.bar({ mode = "video", since = 0 }, 1)
		assert.equal(m.fill, "error")
		assert.equal(m.fg, "on_error")
		local hidden = present.bar(nil, 1)
		assert.equal(hidden.fill ~= nil, true)
		assert.equal(hidden.fg ~= nil, true)
	end)

	it("explains that a click stops the recording", function()
		local m = present.bar({ mode = "gif", since = 0 }, 1)
		assert.equal(string.find(m.tooltip, "clique para parar", 1, true) ~= nil, true)
	end)
end)
